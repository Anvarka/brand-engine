# ---- LLM ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Model tiers. Verify the exact names available to your account with:
#   python scripts/llm.py --list-models
LLM_MODEL_CHEAP=gpt-5.6-luna       # harvest scoring, dedupe
LLM_MODEL_DEFAULT=gpt-5.6-terra    # drafting + critic
LLM_MODEL_SMART=gpt-5.6-sol        # weekly strategy digest

# ---- Telegram (same bot as ~/proj/telegram-mcp) ----
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# ---- LinkedIn ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx
LINKEDIN_API_VERSION=202608

# Where the source link goes: comment (default, protects reach) | body | none
LINK_PLACEMENT=telegram
